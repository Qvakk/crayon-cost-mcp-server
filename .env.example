# Crayon CloudIQ API Configuration
CRAYON_CLIENT_ID=your_client_id_here
CRAYON_CLIENT_SECRET=your_client_secret_here
CRAYON_USERNAME=your_username_here
CRAYON_PASSWORD=your_password_here
CRAYON_API_BASE_URL=https://api.crayon.com/api/v1

# Server Configuration
PORT=3003
HOST=0.0.0.0
TRANSPORT_MODE=http
NODE_ENV=production

# Localization - Chart and report formatting
# Supported: 'en' (English) or 'no' (Norwegian)
LOCALE=en

# Logging Configuration
# Default: 'error' - Only log errors (recommended for production)
# Options: 'error', 'warn', 'info', 'debug'
# Note: PII is automatically redacted from all logs
LOG_LEVEL=error

# API Configuration
API_TIMEOUT_MS=30000
CIRCUIT_BREAKER_THRESHOLD=50
CIRCUIT_BREAKER_TIMEOUT_MS=30000

# Authentication Configuration
AUTH_ENABLED=true
AUTH_TOKEN=your-secret-token-for-bearer-auth

# Organization Access Control
# Comma-separated list of organization IDs that users can access
# Example: 4040561,4019092
ALLOWED_ORGANIZATIONS=

# Rate Limiting Configuration
# Window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Maximum requests per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# Session Management
# Session timeout in milliseconds (default: 1800000 = 30 minutes)
SESSION_TIMEOUT_MS=1800000
# Cleanup interval in milliseconds (default: 60000 = 1 minute)
SESSION_CLEANUP_INTERVAL_MS=60000

# Request Timeout
# Maximum time for a single request (default: 60000 = 1 minute)
REQUEST_TIMEOUT_MS=60000

# Response Caching
# Enable/disable response caching for expensive queries
CACHE_ENABLED=true
# Cache TTL in milliseconds (default: 300000 = 5 minutes)
CACHE_TTL_MS=300000
# Maximum number of cached responses
CACHE_MAX_SIZE=100

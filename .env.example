# Crayon CloudIQ API Configuration
CRAYON_CLIENT_ID=your_client_id_here
CRAYON_CLIENT_SECRET=your_client_secret_here
CRAYON_USERNAME=your_username_here
CRAYON_PASSWORD=your_password_here
CRAYON_API_BASE_URL=https://api.crayon.com/api/v1

# Server Configuration
# HTTP is the only supported transport (Streamable HTTP on POST /mcp).
PORT=3003
HOST=0.0.0.0
NODE_ENV=production

# Localization - Chart and report formatting
# Supported: 'en' (English) or 'no' (Norwegian)
LOCALE=en

# Logging Configuration
# Default: 'error' - Only log errors (recommended for production)
# Options: 'error', 'warn', 'info', 'debug'
# Note: PII is automatically redacted from all logs
LOG_LEVEL=error

# API Configuration
API_TIMEOUT_MS=30000
CIRCUIT_BREAKER_THRESHOLD=50
CIRCUIT_BREAKER_TIMEOUT_MS=30000

# Authentication Configuration
#
# AUTH_MODE selects the strategy:
#   entra  - Entra ID (Azure AD) OAuth2 access tokens. REQUIRED for the
#            production deployment (Container App behind App Gateway + APIM).
#   token  - legacy shared AUTH_TOKEN. Local/docker-compose only.
#   none   - auth disabled. Local development only; never in Azure.
# If AUTH_MODE is omitted it is inferred: ENTRA_* configured => entra, else token.
AUTH_ENABLED=true
AUTH_MODE=entra

# Legacy shared token (only used when AUTH_MODE=token)
AUTH_TOKEN=your-secret-token-for-bearer-auth

# ---------------------------------------------------------------------------
# Entra ID (Azure AD) app registration
# ---------------------------------------------------------------------------
# Tenant (directory) ID of the API's app registration
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# Application ID URI of the API app registration (exposes the api:// scope).
# Both `api://<client-id>` and the bare client id are accepted.
ENTRA_AUDIENCE=api://your-api-client-id
# Authority host - change only for sovereign clouds
# (e.g. login.microsoftonline.us, login.microsoftonline.cn)
ENTRA_AUTHORITY_HOST=login.microsoftonline.com
# Optional explicit JWKS URL (required behind private endpoints / proxies)
# ENTRA_JWKS_URI=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys
# Optional delegated scope that must be present on the token.
# Skipped for app-only (client-credentials) tokens, which carry roles but no scp.
# ENTRA_REQUIRED_SCOPE=access_as_user

# App roles defined in the API app registration's manifest.
# Read-only tools require user.read; mutating tools require user.write.
ENTRA_READ_ROLE=user.read
ENTRA_WRITE_ROLE=user.write

# Organization Access Control
# Comma-separated list of organization IDs that users can access
# Example: 4040561,4019092
ALLOWED_ORGANIZATIONS=

# Comma-separated list of organization IDs that may be MUTATED.
# Empty = every ALLOWED_ORGANIZATIONS entry is writable.
# Example: 4040561
ALLOWED_WRITE_ORGANIZATIONS=

# Rate Limiting Configuration
# Window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Maximum requests per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# Session Management
# Housekeeping interval in milliseconds (default: 60000 = 1 minute).
# Note: MCP session lifecycle is owned by the SDK handler, so there is no
# separate session timeout to configure.
SESSION_CLEANUP_INTERVAL_MS=60000

# Request Timeout
# Maximum time for a single request (default: 60000 = 1 minute)
REQUEST_TIMEOUT_MS=60000

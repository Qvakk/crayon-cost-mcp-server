{
  "name": "crayon-cost-mcp",
  "version": "1.1.0",
  "description": "MCP server for Crayon CloudIQ cost and billing APIs with HTTP transport",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "watch": "tsc --watch",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "test:smoke": "npm run build && node scripts/http-smoke.mjs && node scripts/authz-smoke.mjs && node scripts/entra-auth-smoke.mjs",
    "test:tools": "npm run build && node scripts/tools-api-test.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "crayon",
    "cloudiq",
    "cost",
    "billing",
    "azure"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "jose": "^6.2.12",
    "opossum": "^10.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/opossum": "^8.1.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
